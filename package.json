		"sveltekit-search-params": "^4.0.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"fuzzysort": "^4.0.2",
		"gray-matter": "^4.0.3",
		"markdown-it": "^15.0.1",
